# API Server Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_salt
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute
BODY_LIMIT_MB=15

# PostgreSQL Connection String (leave blank for local embedded PGlite)
DATABASE_URL=
