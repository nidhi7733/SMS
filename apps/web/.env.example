# Frontend Web App Environment Configuration

# In local development, leave VITE_API_BASE_URL empty so that Vite proxy (/api -> http://localhost:4000/api) is used.
# In production, if API is hosted separately, specify full URL: e.g. https://api.school.edu.np
VITE_API_BASE_URL=

VITE_APP_TITLE="Hamro School Management System (SMS)"
