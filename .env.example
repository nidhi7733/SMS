# ==============================================================================
# Hamro School Management System (SMS) - Environment Configuration
# ==============================================================================

# Application Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Server Host & Port
PORT=4000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# JWT Secret Key: REQUIRED in production (minimum 32 characters recommended)
# Generate a secure string e.g. using: openssl rand -base64 32
JWT_SECRET=sms_dev_jwt_secret_nepal_2083_super_secure

# Token lifespan (e.g., '15m', '1h', '24h', '7d')
JWT_EXPIRES_IN=7d

# Cookie Secret Key (optional signed cookie salt)
COOKIE_SECRET=sms_cookie_secret_nepal_2083_secure_salt

# Allowed CORS Origins (comma-separated for multiple domains, or '*' for open)
# In development, leave blank or set to 'http://localhost:5173'
# In production, set to your frontend domain e.g. 'https://sms.school.edu.np'
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (Protection against DDoS and Brute Force)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute

# Request Body Limit in MB (covers Excel import and Student Photos)
BODY_LIMIT_MB=15

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# For Local Development:
#   Leave DATABASE_URL blank to use embedded persistent PostgreSQL (PGlite)
#   Data is stored locally in ./data/sms_pg
#
# For Production:
#   Provide full PostgreSQL connection string:
#   DATABASE_URL=postgresql://sms_user:StrongPassword123@localhost:5432/sms_db?sslmode=prefer
DATABASE_URL=

# ------------------------------------------------------------------------------
# Frontend / Vite Configuration
# ------------------------------------------------------------------------------
# In development, leave blank to use the Vite proxy (/api -> http://localhost:4000/api)
# In production, if API is hosted on a separate domain, set:
# VITE_API_BASE_URL=https://api.school.edu.np
VITE_API_BASE_URL=
VITE_APP_TITLE="Hamro School Management System (SMS)"
